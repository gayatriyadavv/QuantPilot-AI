# ---- CookLens Environment Configuration ----

# AI Configuration
# Set your OpenAI API key for real AI analysis
# Leave empty to use mock data (demo mode)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# For Ollama (local), use:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# AI_MODEL=llama3.2-vision

# For LM Studio (local), use:
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=lm-studio

# Mock Mode - set to true to use built-in mock data
USE_MOCK_DATA=true

# Backend
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
