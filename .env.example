# ============================================================
# QuantPilot AI — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://quantpilot:quantpilot@localhost:5432/quantpilot
# SQLite (local development — used if DATABASE_URL is not set)
# DATABASE_URL=sqlite+aiosqlite:///./data/quantpilot.db

# --- API Keys ---
# Binance (required for crypto data)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# News API (optional — https://newsapi.org)
NEWS_API_KEY=

# --- Application ---
APP_NAME=QuantPilot AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:8501
BACKEND_URL=http://localhost:8000

# --- Trading Defaults ---
DEFAULT_INITIAL_BALANCE=100000.0
DEFAULT_COMMISSION_RATE=0.001
DEFAULT_SLIPPAGE=0.0005
MAX_POSITION_SIZE=0.25
MAX_DAILY_LOSS=0.05

# --- RL Training ---
DEFAULT_TRAINING_TIMESTEPS=100000
DEFAULT_WINDOW_SIZE=30
DEFAULT_ALGORITHM=PPO
MODEL_CHECKPOINT_DIR=./models/checkpoints

# --- Sentiment ---
FINBERT_MODEL=ProsusAI/finbert
SENTIMENT_CACHE_TTL=3600

# --- Redis (optional — for caching) ---
REDIS_URL=redis://localhost:6379/0
